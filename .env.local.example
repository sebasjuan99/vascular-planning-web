# Supabase - NEXT_PUBLIC_ vars are safe in the browser (anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEVER expose this to the browser - server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin - server-side only, never prefix with NEXT_PUBLIC_
ADMIN_SECRET=generate-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@yourplatform.com

# Email - server-side only
RESEND_API_KEY=re_your_resend_key

# MercadoPago - server-side only, never prefix with NEXT_PUBLIC_
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret

# Cloudflare Turnstile - site key is public, secret key stays server-side
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# App URL
NEXT_PUBLIC_APP_URL=https://vascularplanning.vercel.app
